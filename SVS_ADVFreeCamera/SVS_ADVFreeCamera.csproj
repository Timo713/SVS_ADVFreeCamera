<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<OutputType>Library</OutputType>
		<AssemblyName>SVS_ADVFreeCamera</AssemblyName>
		<RootNamespace>SVS_ADVFreeCamera</RootNamespace>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<!-- Don't copy referenced DLLs into the output folder. A BepInEx plugin
		     ships as a single DLL; the game already has everything else. -->
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<!-- Version must match the BepInEx actually installed in the test game
	     (LogOutput.log reports 6.0.0-be.752). -->
	<ItemGroup>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.752" />
	</ItemGroup>

	<!-- The game is IL2CPP, so its C# API is exposed through "interop" assemblies
	     that BepInEx generates next to the game. Referencing those directly
	     guarantees we compile against exactly the API that exists at runtime.
	     Private=false means "reference it, don't copy it into our output". -->
	<!-- Set InteropPath to your own game folder. Copy Local.props.example to
	     Local.props and edit it (Local.props is not tracked by git), or pass it
	     on the command line:
	       dotnet build -p:InteropPath="C:\Games\SVS\BepInEx\SamabakeScramble\interop" -->
	<Import Project="$(MSBuildThisFileDirectory)..\Local.props"
	        Condition="Exists('$(MSBuildThisFileDirectory)..\Local.props')" />

	<Target Name="CheckInteropPath" BeforeTargets="BeforeBuild">
		<Error Condition="'$(InteropPath)' == ''"
		       Text="InteropPath is not set. Copy Local.props.example to Local.props and point it at your game's BepInEx\SamabakeScramble\interop folder." />
		<Error Condition="!Exists('$(InteropPath)')"
		       Text="No interop assemblies at &quot;$(InteropPath)&quot;. Run the game once with BepInEx installed so it can generate them, then check the path in Local.props." />
	</Target>

	<ItemGroup>
		<Reference Include="$(InteropPath)\*.dll">
			<Private>false</Private>
		</Reference>
	</ItemGroup>
</Project>
